---
import '../styles/admin.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" />
    <title>Obelisk Books — new website in progress</title>
  </head>
  <body class="min-h-screen grid place-items-center p-6">
    <main class="text-center max-w-md">
      <img src="/logo-square.png" alt="Obelisk Books logo" class="h-24 mx-auto mb-4" />
      <h1 class="text-2xl font-bold mb-2">New website in progress</h1>
      <p class="text-muted mb-6">The public pages are built in Phase 3. The store currently runs at obeliskbooks.com.</p>
      <a class="btn-primary" href="/admin/">Open the dashboard</a>
    </main>
  </body>
</html>
