---
import Site from '../layouts/Site.astro';
import { getSite, href, translator } from '../lib/site/site';
const s = await getSite();
const lang = s.lang('en');
const t = translator(s, 'en');
---
<Site lang="en" title={`${t('404.title')} | ${t('site.name')}`} alternates={{}} noindex>
  <div class="center-page">
    <h1>{t('404.title')}</h1>
    <p class="muted" style="font-size:18px">{t('404.text')}</p>
    <a class="btn btn-teal btn-lg" href={href(lang, '/')}>{t('404.button')}</a>
    <form class="search-form" role="search" action={href(lang, '/search')} method="get" style="width:100%;max-width:420px;flex:none">
      <label for="q404" class="sr-only">{t('404.search')}</label>
      <input id="q404" name="q" type="search" placeholder={t('404.search')} />
      <button class="icon-btn" type="submit">{t('nav.search_button')}</button>
    </form>
  </div>
</Site>
