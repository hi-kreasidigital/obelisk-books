---
import ShellPage from '../../../components/site/ShellPage.astro';
import { getSite, href, langPaths, translator } from '../../../lib/site/site';
export const getStaticPaths = langPaths;
const s = await getSite();
const lang = s.lang(Astro.props.lang);
const t = translator(s, lang.code);
---
<ShellPage lang={lang.code} path="/newsletter/preferences" title={t('newsletter.prefs.title')} soon>
  <form class="form" style="text-align:left" data-newsletter><label class="filters" style="display:flex;gap:10px;align-items:center"><input type="checkbox" checked /> {t('newsletter.prefs.books')}</label>
  <label style="display:flex;gap:10px;align-items:center"><input type="checkbox" checked /> {t('newsletter.prefs.articles')}</label><input type="email" hidden value="x@example.com" />
  <button class="btn btn-teal" type="submit">{t('newsletter.prefs.save')}</button><p class="small" data-nl-msg role="status"></p></form>
</ShellPage>
