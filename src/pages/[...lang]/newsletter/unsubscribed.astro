---
import ShellPage from '../../../components/site/ShellPage.astro';
import { getSite, href, langPaths, translator } from '../../../lib/site/site';
export const getStaticPaths = langPaths;
const s = await getSite();
const lang = s.lang(Astro.props.lang);
const t = translator(s, lang.code);
---
<ShellPage lang={lang.code} path="/newsletter/unsubscribed" title={t('newsletter.unsub.title')} text={t('newsletter.unsub.text')}><a class="btn btn-teal btn-lg" href={href(lang, '/')}>{t('404.button')}</a></ShellPage>
