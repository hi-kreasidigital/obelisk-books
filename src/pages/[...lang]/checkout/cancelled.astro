---
import ShellPage from '../../../components/site/ShellPage.astro';
import { getSite, href, langPaths, translator } from '../../../lib/site/site';
export const getStaticPaths = langPaths;
const s = await getSite();
const lang = s.lang(Astro.props.lang);
const t = translator(s, lang.code);
---
<ShellPage lang={lang.code} path="/checkout/cancelled" title={t('checkout.cancel.title')} text={t('checkout.cancel.text')}><a class="btn btn-teal btn-lg" href={href(lang, '/cart')}>{t('checkout.cancel.back')}</a></ShellPage>
