---
import ShellPage from '../../components/site/ShellPage.astro';
import { getSite, href, langPaths, translator } from '../../lib/site/site';
export const getStaticPaths = langPaths;
const s = await getSite();
const lang = s.lang(Astro.props.lang);
const t = translator(s, lang.code);
---
<ShellPage lang={lang.code} path="/order-lookup" title={t('lookup.title')} text={t('lookup.intro')} soon>
  <form class="form" style="width:100%;text-align:left" data-newsletter><div class="field"><label for="ol-order">{t('lookup.order')}</label><input id="ol-order" required /></div>
  <div class="field"><label for="ol-email">{t('lookup.email')}</label><input id="ol-email" type="email" required autocomplete="email" /></div>
  <button class="btn btn-teal btn-lg" type="submit">{t('lookup.button')}</button><p class="small" data-nl-msg role="status"></p></form>
</ShellPage>
