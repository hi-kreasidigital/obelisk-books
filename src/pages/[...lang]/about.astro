---
import Site from '../../layouts/Site.astro';
import { getSite, href, langPaths, organization, staticAlternates, translator } from '../../lib/site/site';
export const getStaticPaths = langPaths;
const s = await getSite();
const lang = s.lang(Astro.props.lang);
const t = translator(s, lang.code);
const parts = ['publish', 'where', 'collections', 'ebooks', 'print', 'service'];
---
<Site lang={lang.code} title={t('meta.about.title')} description={t('meta.about.desc')} alternates={staticAlternates(s, '/about')} crumbs={[{ name: t('nav.about') }]}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'AboutPage', inLanguage: lang.code, mainEntity: organization(s) }]}>
  <div class="wrap page-head"><span class="eyebrow">{t('home.hero.eyebrow')}</span><h1>{t('about.title')}</h1><p>{t('about.intro')}</p></div>
  <div class="wrap" style="padding-bottom:64px">
    <div class="collection-cards">
      {parts.map((k) => <section class="box"><h2 style="font-family:var(--head);font-weight:500;font-size:24px">{t(`about.${k}.title`)}</h2><p class="muted">{t(`about.${k}.text`)}</p></section>)}
    </div>
    <p style="margin-top:28px">{t('about.company')}</p>
    <p style="margin-top:20px"><a class="btn btn-teal btn-lg" href={href(lang, '/books')}>{t('about.cta')}</a></p>
  </div>
</Site>
